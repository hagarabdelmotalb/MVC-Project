@using Demo.BLL.DTOS

@model IEnumerable<DepartmentDto>
@{
    ViewData["Title"] = "Index";
}

<h1 class="my-3">All Departments</h1>
<br />
<a class="btn btn-primary my-3" asp-controller="Department" asp-action="Create">Create new Department</a>

@if (Model.Any())
{
    <table class="table table-hover table-striped mt-3">
        <thead class="text-center">
            <tr>
                <th>@Html.DisplayNameFor(d => d.Code)</th>
                <th>@Html.DisplayNameFor(d => d.Name)</th>
                <th>@Html.DisplayNameFor(d => d.Description)</th>
                <th>@Html.DisplayNameFor(d => d.DateOfCreation)</th>
                <th>Details</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody class="text-center">
            @foreach(var department in Model)
            {
                <tr>
                    <td>@department.Code</td>
                    <td>@department.Name</td>
                    <td>@department.Description</td>
                    <td>@department.DateOfCreation.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a class="btn btn-primary" asp-controller="Department" asp-action="Details" asp-route-Id="@department.DepId"> <i class="fas fa-eye"></i> Details </a>
                    </td>

                    <td>
                        <a class="btn btn-success" asp-controller="Department" asp-action="Edit" asp-route-Id="@department.DepId"> <i class="fas fa-edit"></i> Edit </a>
                    </td>
                    <td>
                        <a class="btn btn-danger" asp-controller="Department" asp-action="Delete" asp-route-Id="@department.DepId"> <i class="fas fa-trash"></i> Delete </a>
                    </td>
                </tr>
			}
	)
        </tbody>
    </table>
}
else
{
    <div class="alert alert-warning mt-3" role="alert">
        No departments found.
    </div>
}