@model EmployeeViewModel
@inject IDepartmentService _departmentService

@{
    var Departments = new SelectList(_departmentService.GetAllDepartments() , "DepId" , nameof(DepartmentDto.Name));
}

@* Name *@
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="Name"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>

@* Email *@
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="Email"></label>
    <input asp-for="Email" class="form-control" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>

@* Address *@
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="Address"></label>
    <input asp-for="Address" class="form-control" />
    <span asp-validation-for="Address" class="text-danger"></span>
</div>

@* phone *@
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="PhoneNumber"></label>
    <input asp-for="PhoneNumber" class="form-control" />
    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
</div>

@* Age *@
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="Age"></label>
    <input asp-for="Age" class="form-control" />
    <span asp-validation-for="Age" class="text-danger"></span>
</div>

@* HiringDate *@
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="HiringDate"></label>
    <input type="date" asp-for="HiringDate" class="form-control" />
    <span asp-validation-for="HiringDate" class="text-danger"></span>
</div>

@* salary *@
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="Salary"></label>
    <input asp-for="Salary" class="form-control" />
    <span asp-validation-for="Salary" class="text-danger"></span>
</div>

@* Department Dropdown *@
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="DepartmentId"> </label>
    <select class="form-control" asp-for="DepartmentId" asp-items="Departments">
        <option value="@null">Select a Department</option>
    </select>
    <span asp-validation-for="EmployeeType" class="text-danger"></span>
</div>

@* Employee Type *@
<div class="form-group mb-3 col-6">
    <label class="form-label" asp-for="EmployeeType">Employee Type</label>
    <select class="form-control" asp-for="EmployeeType" asp-items="Html.GetEnumSelectList<EmployeeType>()">
    </select>

    <span asp-validation-for="EmployeeType" class="text-danger"></span>
</div>


@* IsActive *@
<div class="form-group mb-3 col-6">
    <input asp-for="IsActive" class="form-check-input" />
    <label class="col-form-label" asp-for="IsActive"></label>
</div>

<div class="form-group mb-3 col-6">
    <label class="col-form-label" asp-for="Gender"></label>
    <div>
        @foreach (var genderOption in Enum.GetValues<Gender>())
        {
            <div class="form-check form-check-inline">
                <input class="form-check-input" asp-for="Gender" type="radio" value="@genderOption" />
                <label class="form-check-label">@genderOption</label>
            </div>
        }
    </div>
</div>